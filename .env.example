# Google Directions API key used for building travel legs between road segments.
# Rename this file to `.env` and replace the placeholder with your actual key.
GOOGLE_API_KEY=PASTE_YOUR_KEY_HERE
YANDEX_API_KEY=
BASE_LAT=54.909901
BASE_LON=37.363422
VALIDATE_COORD_ORDER=True
ADVANCED_OPTIMIZATION=True

# Optional: secret used by Flask sessions.
# FLASK_SECRET=change-me
