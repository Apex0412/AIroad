# Flask
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
SECRET_KEY=change_me

# API keys
GOOGLE_API_KEY=your_google_key
YANDEX_API_KEY=your_yandex_key

# Routing
ROUTING_PROVIDER=google
GOOGLE_MAX_WAYPOINTS=23
REQUEST_PAUSE=0.35
SAMPLE_EVERY_M=150.0

# Geocoding source for street names
STREET_SOURCE=google

# Dispatch logic
USE_GRID_BY_DEFAULT=true
ADVANCED_OPTIMIZATION=false
TARGET_KM_PER_TRACTOR=30000
MERGE_DIST_M=500
